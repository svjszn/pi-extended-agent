{
  "name": "pi-extended-agent",
  "version": "1.2.0",
  "description": "Pi Coding Agent with a custom interface and managed engine updates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svjszn/pi-extended-agent.git"
  },
  "homepage": "https://github.com/svjszn/pi-extended-agent#readme",
  "bugs": { "url": "https://github.com/svjszn/pi-extended-agent/issues" },
  "keywords": ["pi", "coding-agent", "cli", "terminal", "ai"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi": "bin/pi.mjs",
    "pi-extended-agent": "bin/pi.mjs"
  },
  "scripts": {
    "start": "node bin/pi.mjs",
    "pi": "node bin/pi.mjs",
    "check": "npm run typecheck",
    "test": "node scripts/run-tests.mjs test/pi-interface.test.mjs test/startup.test.mjs test/auth-screen.test.mjs test/extension-runtime.test.mjs test/escape-exit.test.mjs test/update.test.mjs test/commands.test.mjs test/command-loading.test.mjs test/skills.test.mjs test/context.test.mjs test/effort.test.mjs test/command-policy.test.mjs test/permissions.test.mjs test/model-screen.test.mjs test/workspace.test.mjs test/appearance.test.mjs test/performance.test.mjs test/build.test.mjs",
    "smoke": "node bin/pi.mjs --no-session --no-tools --no-extensions --no-skills --no-prompt-templates --no-context-files --print \"Reply with exactly: PI_OK\"",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build && npm run build:dev",
    "prestart": "npm run build",
    "prepi": "npm run build"
  },
  "files": [
    "bin/pi.mjs",
    "dist/",
    "ui/*.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extensions/appearance.js",
      "./dist/extensions/commands.js",
      "./dist/extensions/config.js",
      "./dist/extensions/effort.js",
      "./dist/extensions/escape-exit.js",
      "./dist/extensions/permissions.js",
      "./dist/extensions/pi-interface.js",
      "./dist/extensions/skills.js",
      "./dist/extensions/update-notice.js",
      "./dist/extensions/workspace.js"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "6.0.3"
  }
}
